APP_NAME=ArveX Hosting
ENVIRONMENT=development
LOG_LEVEL=INFO

# Generate long random secrets. Never commit real values.
DATABASE_URL=postgresql+asyncpg://arvex:change-me@localhost:5432/arvex
REDIS_URL=redis://localhost:6379/0

DISCORD_TOKEN=
DISCORD_GUILD_ID=
INTERNAL_API_SECRET=GENERATE_32_PLUS_RANDOM_CHARS
ADMIN_DASHBOARD_TOKEN=GENERATE_A_LONG_RANDOM_TOKEN
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=GENERATE_FERNET_KEY

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

PTERODACTYL_URL=https://panel.example.com
PTERODACTYL_API_KEY=
PTERODACTYL_CLIENT_API_KEY=

DOCKER_NODE_NAME=local-01
DOCKER_NETWORK=arvex-vps
VPS_IMAGE=ubuntu:24.04
ALLOWED_VPS_IMAGES=ubuntu:24.04
VPS_ROOTFS=/srv/arvex/vps
VPS_PUBLIC_HOST=YOUR_NODE_PUBLIC_IP_OR_DNS
MAX_VPS_RAM_MB=65536
MAX_VPS_CPU_PERCENT=1200
MAX_VPS_DISK_MB=262144
DEPLOYMENT_CONCURRENCY=2
MAX_DEPLOYMENT_ATTEMPTS=3

CORS_ORIGINS=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

# Optional: leave empty until an SSHX gateway is configured.
SSHX_COMMAND_TEMPLATE=
